{
  "name": "fuck-eu-chat-control",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "test:unit": "vp run -r test:unit",
    "test:e2e": "vp run -r test:e2e",
    "test": "vp run -r test:unit && vp run -r test:e2e",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "build:desktop": "pnpm --filter desktop build",
    "check:rust": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:desktop": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "dev:mobile": "pnpm --filter mobile start",
    "build:mobile:android": "pnpm --filter mobile exec expo prebuild --platform android",
    "check-types:mobile": "pnpm --filter mobile check-types",
    "test:mobile": "pnpm --filter mobile test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@fuck-eu-chat-control/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fuck-eu-chat-control/config": "workspace:*",
    "@types/node": "catalog:",
    "rolldown": "1.1.4",
    "typescript": "catalog:",
    "vite-plus": "0.2.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2"
  },
  "packageManager": "pnpm@10.33.4"
}
