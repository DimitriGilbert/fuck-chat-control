# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
build
*.tsbuildinfo

# Generated files
apps/web/src/routeTree.gen.ts

# wasm-pack regenerates pkg/.gitignore on every build; the six built artifacts
# inside pkg/ are force-tracked, so we must ignore only the regenerated
# .gitignore itself to keep the tree clean across rebuilds.
packages/chat-runtime/wasm/spake2/pkg/.gitignore

# Environment variables
.env
.env*.local

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Turbo
.turbo
.nx

# Better-T-Stack
.alchemy
.vercel

# Testing
coverage
.nyc_output

# Misc
*.tgz
.cache
tmp
temp

# Tauri (desktop app) build artifacts. The committed sources live in
# apps/desktop/src-tauri; only the compiled Rust target/ and the tauri dev
# build of the frontend are gitignored.
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Expo / React Native generated native trees. `apps/mobile/android/` and
# `apps/mobile/ios/` are the output of `expo prebuild` (incl. gradle build
# output), regenerable from app.json + the plugins config. `.expo/` is Expo's
# local state. None of these are source — never commit them.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/

# Local review / planning working artifacts (subagent-review sessions, scratch
# briefs, baselines). Not part of the shipped product.
.review/
.phase-b-brief.md
.phase-c-brief.md
PLAN-native-apps.md
BASELINE.md
FAILURE-react-419.md
